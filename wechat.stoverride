#!desc=微信公众号去广告
#!author=HotKids
name: WechatAdFree
desc: 微信公众号去广告
http:
  mitm:
    - "mp.weixin.qq.com"
  script:
    - match: ^https?:\/\/mp\.weixin\.qq\.com\/mp\/getappmsgad
      name: WechatAdFree1
      type: response
      require-body: true
      timeout: 10
script-providers:
  WechatAdFree1:
    url: https://raw.githubusercontent.com/FlyfishO25/stashscript/refs/heads/main/js/wechat.js
    interval: 86400
